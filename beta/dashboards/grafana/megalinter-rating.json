{
  "annotations": {
    "list": []
  },
  "description": "Explanation of the repository rating: score formula, linters breakdown and improvement path",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "MegaLinter dashboards",
      "type": "dashboards",
      "tags": [
        "megalinter"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "targetBlank": false
