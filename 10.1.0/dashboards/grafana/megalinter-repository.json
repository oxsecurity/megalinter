{
  "annotations": {
    "list": [
      {
        "name": "MegaLinter runs",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "{source=\"MegaLinter\",recordType=\"run\",gitRepoName=~\"$repo\",gitBranchName=~\"$branch\"}"
      }
    ]
  },
  "description": "Quality gate, KPIs and trends for a single repository monitored by MegaLinter",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "MegaLinter dashboards",
      "type": "dashboards",
      "tags": [
        "megalinter"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Documentation",
      "url": "https://megalinter.io/latest/observability/grafana/",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 18,
      "type": "stat",
      "title": "Quality gate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "PASS",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "last_over_time((min (megalinter_run_qualityGate{gitRepoName=~\"$repo\",gitBranchName=~\"$branch\"}))[$__range:])",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "description": "Worst-case (min) quality gate of the latest run of each selected series: FAIL as soon as one selected branch failed its latest run."
    },
