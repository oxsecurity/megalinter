    {
      "id": 25,
      "type": "stat",
      "title": "Fix rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [],
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "100 * last_over_time((sum (megalinter_run_totalErrorsFixed{gitRepoName=~\"$repo\",gitBranchName=~\"$branch\"}))[$__range:]) / clamp_min(last_over_time((sum (megalinter_run_totalErrorsFixed{gitRepoName=~\"$repo\",gitBranchName=~\"$branch\"}))[$__range:]) + last_over_time((sum (megalinter_run_totalErrors{gitRepoName=~\"$repo\",gitBranchName=~\"$branch\"}))[$__range:]), 1)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Health score",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "mappings": [],
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "auto",
        "textMode": "auto"
      },
