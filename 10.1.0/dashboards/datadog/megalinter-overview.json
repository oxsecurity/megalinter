        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "avg:megalinter.run.healthScore{$git_repo_name,$git_branch_name} by {megalinter_version}",
                "aggregator": "avg"
              }
            ],
            "formulas": [
              {
                "formula": "q1",
                "limit": {
                  "count": 15,
                  "order": "desc"
                }
              }
