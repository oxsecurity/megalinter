        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.totalErrorsFixed{$git_repo_name,$git_branch_name} by {git_repo_name}"
              }
            ],
