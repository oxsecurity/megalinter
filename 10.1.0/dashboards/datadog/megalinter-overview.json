        ]
      }
    },
    {
      "definition": {
        "title": "Top rules",
        "type": "toplist",
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "logs",
                "name": "q1",
                "search": {
                  "query": "source:megalinter record_type:rule $git_repo_name $git_branch_name"
                },
                "indexes": [
                  "*"
                ],
                "group_by": [
                  {
                    "facet": "@megalinter.ruleId",
                    "limit": 15,
                    "sort": {
                      "aggregation": "sum",
                      "metric": "@megalinter.occurrences",
                      "order": "desc"
                    }
                  }
                ],
                "compute": {
                  "aggregation": "sum",
                  "metric": "@megalinter.occurrences"
                },
                "storage": "hot"
              }
            ],
            "formulas": [
              {
                "formula": "q1",
                "limit": {
                  "count": 15,
                  "order": "desc"
                }
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Top files",
        "type": "toplist",
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
