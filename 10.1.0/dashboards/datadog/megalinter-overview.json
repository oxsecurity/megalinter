                "group_by": [
                  {
                    "facet": "@megalinter.file",
                    "limit": 15,
                    "sort": {
                      "aggregation": "sum",
                      "metric": "@megalinter.occurrences",
                      "order": "desc"
                    }
                  }
                ],
                "compute": {
                  "aggregation": "sum",
