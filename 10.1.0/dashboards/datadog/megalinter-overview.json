{
  "title": "MegaLinter - Overview",
  "description": "MegaLinter results: quality gate, errors, linters and top rules. Generated from MegaLinter payload v2.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    {
      "name": "git_repo_name",
      "prefix": "git_repo_name",
      "available_values": [],
      "defaults": [
        "*"
      ]
    },
    {
      "name": "git_branch_name",
      "prefix": "git_branch_name",
      "available_values": [],
      "defaults": [
        "*"
      ]
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "note",
        "content": "**MegaLinter Observability** | [Logs explorer](/logs?query=source:megalinter) | [Documentation](https://megalinter.io/latest/observability/datadog/) | Use the `git_repo_name` / `git_branch_name` variables above to focus a repository or branch, and the *Why this rating?* section below to understand the health score.",
        "background_color": "white",
        "font_size": "14",
        "text_align": "left",
        "show_tick": false
      }
    },
    {
      "definition": {
        "title": "Quality gate pass rate (%)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "timeseries_background": {
          "type": "area"
        },
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "avg:megalinter.run.qualityGate{$git_repo_name,$git_branch_name}",
                "aggregator": "avg"
              }
            ],
            "formulas": [
              {
                "formula": "q1 * 100"
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": ">=",
                "value": 90,
                "palette": "white_on_green"
              },
              {
                "comparator": ">=",
                "value": 50,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<",
                "value": 50,
                "palette": "white_on_red"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Health score (avg)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "timeseries_background": {
          "type": "area"
        },
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "avg:megalinter.run.healthScore{$git_repo_name,$git_branch_name}",
                "aggregator": "avg"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": ">=",
                "value": 80,
                "palette": "white_on_green"
              },
              {
                "comparator": ">=",
                "value": 50,
                "palette": "white_on_yellow"
              },
              {
                "comparator": "<",
                "value": 50,
                "palette": "white_on_red"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Repositories monitored",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "timeseries_background": {
          "type": "area"
        },
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.lintersCount{$git_repo_name,$git_branch_name} by {git_repo_name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "count_nonzero(q1)"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runs (period)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "logs",
                "name": "q1",
                "search": {
                  "query": "source:megalinter record_type:run $git_repo_name $git_branch_name"
                },
                "indexes": [
                  "*"
                ],
                "group_by": [],
                "compute": {
                  "aggregation": "count"
                },
                "storage": "hot"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Blocking errors (latest runs)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "timeseries_background": {
          "type": "area"
        },
