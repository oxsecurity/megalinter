            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Errors by linter",
        "type": "toplist",
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.linter.numberErrorsFound{$git_repo_name,$git_branch_name} by {linter_key}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1",
                "limit": {
                  "count": 15,
                  "order": "desc"
                }
              }
            ],
            "response_format": "scalar",
            "conditional_formats": [
              {
                "comparator": ">",
                "value": 0,
                "palette": "white_on_red"
              },
              {
                "comparator": "<=",
                "value": 0,
                "palette": "white_on_green"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Slowest linters (s)",
        "type": "toplist",
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.linter.elapsedTime{$git_repo_name,$git_branch_name} by {linter_key}",
