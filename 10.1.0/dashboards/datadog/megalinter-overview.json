    },
    {
      "definition": {
        "title": "Estimated time saved by auto-fixes (min, 5 min/fix)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "timeseries_background": {
          "type": "area"
        },
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:megalinter.run.totalErrorsFixed{$git_repo_name,$git_branch_name}",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "default_zero(q1) * 5"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Repository health score evolution",
        "type": "timeseries",
        "time": {
          "live_span": "1w"
        },
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.healthScore{$git_repo_name,$git_branch_name} by {git_repo_name}"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line",
            "style": {
              "palette": "cool"
            }
          }
        ],
        "custom_links": [
          {
            "label": "Focus on this repository",
            "link": "__SELF_URL__?tpl_var_git_repo_name={{git_repo_name.value}}"
          }
        ],
        "markers": [
          {
            "value": "y = 90",
            "display_type": "ok dashed",
            "label": "A"
          },
          {
            "value": "y = 80",
            "display_type": "ok dashed",
            "label": "B"
          },
          {
            "value": "y = 65",
            "display_type": "warning dashed",
            "label": "C"
          },
          {
            "value": "y = 50",
            "display_type": "error dashed",
            "label": "D"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Total errors by repository",
