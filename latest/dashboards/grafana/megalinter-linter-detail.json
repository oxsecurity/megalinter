  "refresh": "5m",
  "schemaVersion": 41,
  "tags": [
    "megalinter"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Metrics datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2,
        "refresh": 1,
        "regex": "/^(?!.*(alert-state-history|usage-insights|ml-metrics)).*/"
      },
      {
        "name": "DS_LOKI",
        "label": "Logs datasource",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2,
        "refresh": 1,
        "regex": "/^(?!.*(alert-state-history|usage-insights|ml-metrics)).*/"
      },
      {
        "name": "repo",
        "label": "Repository",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(megalinter_run_lintersCount, gitRepoName)",
          "refId": "repo"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "branch",
        "label": "Branch",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(megalinter_run_lintersCount{gitRepoName=~\"$repo\"}, gitBranchName)",
          "refId": "branch"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": []
      },
      {
        "name": "linter",
        "label": "Linter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(megalinter_linter_run_numberErrorsFound{gitRepoName=~\"$repo\"}, linterKey)",
          "refId": "linter"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "MegaLinter - 3. Linter Detail",
  "uid": "megalinter-linter-detail",
  "version": 1,
  "weekStart": ""
}
