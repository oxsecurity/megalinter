          "expr": "last_over_time((max (megalinter_linter_run_blocking{gitRepoName=~\"$repo\",gitBranchName=~\"$branch\",linterKey=~\"$linter\"}))[$__range:])",
          "refId": "A",
          "instant": true,
          "range": false
