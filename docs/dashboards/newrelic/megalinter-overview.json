            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT max(`megalinter.run.filesAnalyzed`) FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} FACET gitRepoName TIMESERIES SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
