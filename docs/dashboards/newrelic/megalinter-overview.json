{
  "name": "MegaLinter - Overview",
  "description": "MegaLinter results: quality gate, errors, linters and top rules. Generated from MegaLinter payload v2.",
  "permissions": "PUBLIC_READ_WRITE",
  "variables": [
    {
      "name": "gitRepoName",
      "title": "Repository (Repository detail page)",
      "type": "NRQL",
      "isMultiSelection": false,
      "replacementStrategy": "STRING",
      "nrqlQuery": {
        "accountIds": [
          "${NEW_RELIC_ACCOUNT_ID}"
        ],
        "query": "SELECT uniques(gitRepoName) FROM Metric WHERE source = 'MegaLinter' SINCE 30 days ago"
      },
      "defaultValues": [
        {
          "value": {
            "string": "%"
          }
        }
      ],
      "options": {
        "ignoreTimeRange": false
      }
    },
    {
      "name": "gitBranchName",
      "title": "Branch",
      "type": "NRQL",
      "isMultiSelection": false,
      "replacementStrategy": "STRING",
      "nrqlQuery": {
        "accountIds": [
          "${NEW_RELIC_ACCOUNT_ID}"
        ],
        "query": "SELECT uniques(gitBranchName) FROM Metric WHERE source = 'MegaLinter' SINCE 30 days ago"
      },
      "defaultValues": [
        {
          "value": {
            "string": "%"
          }
        }
      ],
      "options": {
        "ignoreTimeRange": false
      }
    }
  ],
  "pages": [
    {
      "name": "Overview",
      "widgets": [
        {
          "title": "Quality gate pass rate (%)",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT latest(`megalinter.run.qualityGate`) * 100 AS 'Pass rate %' FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Blocking errors",
          "layout": {
            "column": 5,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT latest(`megalinter.run.blockingErrors`) AS 'Blocking errors' FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} FACET gitRepoName SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "linkedEntityGuids": [
              "__REPOSITORY_DETAIL_PAGE_GUID__"
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 1
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 10
              }
            ]
          }
        },
        {
          "title": "Errors auto-fixed",
          "layout": {
            "column": 9,
            "row": 1,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT latest(`megalinter.run.totalErrorsFixed`) AS 'Errors fixed' FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} FACET gitIdentifier SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Runs (period)",
          "layout": {
            "column": 1,
            "row": 11,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT count(*) AS 'Runs' FROM Log WHERE recordType = 'run' AND gitBranchName LIKE {{gitBranchName}} SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Time saved by auto-fixes (min)",
          "layout": {
            "column": 3,
            "row": 11,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT sum(`megalinter.run.totalErrorsFixed`) * 5 AS 'Minutes saved' FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Blocking vs non-blocking errors",
          "layout": {
            "column": 5,
            "row": 11,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT max(`megalinter.run.blockingErrors`) AS 'Blocking', max(`megalinter.run.nonBlockingErrors`) AS 'Non-blocking' FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} TIMESERIES SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            },
            "colors": {
              "seriesOverrides": [
                {
                  "seriesName": "Blocking",
                  "color": "#d62728"
                },
                {
                  "seriesName": "Non-blocking",
                  "color": "#ffbf00"
                }
              ]
            }
          }
        },
        {
          "title": "Errors auto-fixed by repository",
          "layout": {
            "column": 9,
            "row": 11,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT max(`megalinter.run.totalErrorsFixed`) FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} FACET gitRepoName TIMESERIES SINCE 30 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Slowest linters (s)",
          "layout": {
            "column": 1,
            "row": 14,
            "width": 4,
            "height": 4
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "facet": {
              "showOtherSeries": false
            },
            "nrqlQueries": [
              {
                "accountIds": [
                  "${NEW_RELIC_ACCOUNT_ID}"
                ],
                "query": "SELECT max(`megalinter.linter.elapsedTime`) FROM Metric WHERE source = 'MegaLinter' AND gitBranchName LIKE {{gitBranchName}} FACET linterKey SINCE 30 days ago LIMIT 15"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Files analyzed by repository",
          "layout": {
            "column": 5,
            "row": 14,
            "width": 4,
            "height": 4
          },
          "visualization": {
            "id": "viz.line"
          },
