                "query": "SELECT latest(`megalinter.megalinterVersion`) AS 'Version', latest(`megalinter.megalinterFlavor`) AS 'Flavor' FROM Log WHERE recordType = 'run' AND gitBranchName LIKE {{gitBranchName}} FACET gitRepoName SINCE 30 days ago LIMIT 50"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
