              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "links": [
            {
              "title": "Open repository dashboard",
              "url": "/d/megalinter-repository/megalinter-repository?var-repo=${__field.labels.gitRepoName}&${__url_time_range}"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, max by (gitRepoName) (last_over_time(megalinter_run_blockingErrors{gitBranchName=~\"$branch\"}[$__range])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
