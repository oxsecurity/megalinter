{
  "title": "MegaLinter - Overview",
  "description": "MegaLinter results: quality gate, errors, linters and top rules. Generated from MegaLinter payload v2.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    {
      "name": "git_repo_name",
      "prefix": "git_repo_name",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "git_branch_name",
      "prefix": "git_branch_name",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Quality gate pass rate (%)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "avg:megalinter.run.qualityGate{$git_repo_name,$git_branch_name} * 100",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Health score (avg)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "avg:megalinter.run.healthScore{$git_repo_name,$git_branch_name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Repositories monitored",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.lintersCount{$git_repo_name,$git_branch_name} by {git_repo_name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "count_nonzero(q1)"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Runs (period)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "logs",
                "name": "q1",
                "search": {
                  "query": "source:megalinter record_type:run $git_repo_name $git_branch_name"
                },
                "indexes": [
                  "*"
                ],
                "group_by": [],
                "compute": {
                  "aggregation": "count"
                },
                "storage": "hot"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Blocking errors",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:megalinter.run.blockingErrors{$git_repo_name,$git_branch_name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Non-blocking errors",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:megalinter.run.nonBlockingErrors{$git_repo_name,$git_branch_name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Errors auto-fixed",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:megalinter.run.totalErrorsFixed{$git_repo_name,$git_branch_name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Estimated time saved by auto-fixes (min, 5 min/fix)",
        "type": "query_value",
        "precision": 0,
        "autoscale": false,
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:megalinter.run.totalErrorsFixed{$git_repo_name,$git_branch_name}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1 * 5"
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Repository health score evolution",
        "type": "timeseries",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.healthScore{$git_repo_name,$git_branch_name} by {git_repo_name}"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "custom_links": [
          {
            "label": "Focus on this repository",
            "link": "__SELF_URL__?tpl_var_git_repo_name={{git_repo_name.value}}"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Total errors by repository",
        "type": "timeseries",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.totalErrors{$git_repo_name,$git_branch_name} by {git_repo_name}"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "custom_links": [
          {
            "label": "Focus on this repository",
            "link": "__SELF_URL__?tpl_var_git_repo_name={{git_repo_name.value}}"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Errors by linter over time",
        "type": "timeseries",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.linter.numberErrorsFound{$git_repo_name,$git_branch_name} by {linter_key}"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Errors by language over time",
        "type": "timeseries",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "sum:megalinter.linter.numberErrorsFound{$git_repo_name,$git_branch_name} by {descriptor}"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "timeseries",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Blocking vs non-blocking errors",
        "type": "timeseries",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "blocking",
                "query": "sum:megalinter.run.blockingErrors{$git_repo_name,$git_branch_name}"
              },
              {
                "data_source": "metrics",
                "name": "nonblocking",
                "query": "sum:megalinter.run.nonBlockingErrors{$git_repo_name,$git_branch_name}"
              }
            ],
            "formulas": [
              {
                "formula": "blocking",
                "alias": "blocking"
              },
              {
                "formula": "nonblocking",
                "alias": "nonblocking"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Run duration by repository (s)",
        "type": "timeseries",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.runDurationS{$git_repo_name,$git_branch_name} by {git_repo_name}"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "custom_links": [
          {
            "label": "Focus on this repository",
            "link": "__SELF_URL__?tpl_var_git_repo_name={{git_repo_name.value}}"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Errors auto-fixed by repository",
        "type": "timeseries",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.run.totalErrorsFixed{$git_repo_name,$git_branch_name} by {git_repo_name}"
              }
            ],
            "formulas": [
              {
                "formula": "q1"
              }
            ],
            "response_format": "timeseries",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Errors by linter",
        "type": "toplist",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.linter.numberErrorsFound{$git_repo_name,$git_branch_name} by {linter_key}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1",
                "limit": {
                  "count": 15,
                  "order": "desc"
                }
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Slowest linters (s)",
        "type": "toplist",
        "requests": [
          {
            "queries": [
              {
                "data_source": "metrics",
                "name": "q1",
                "query": "max:megalinter.linter.elapsedTime{$git_repo_name,$git_branch_name} by {linter_key}",
                "aggregator": "last"
              }
            ],
            "formulas": [
              {
                "formula": "q1",
                "limit": {
                  "count": 15,
                  "order": "desc"
                }
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Top rules",
        "type": "toplist",
        "requests": [
          {
            "queries": [
              {
                "data_source": "logs",
                "name": "q1",
                "search": {
                  "query": "source:megalinter record_type:rule $git_repo_name $git_branch_name"
                },
                "indexes": [
                  "*"
                ],
                "group_by": [
                  {
                    "facet": "@megalinter.ruleId",
                    "limit": 15,
                    "sort": {
                      "aggregation": "sum",
                      "metric": "@megalinter.occurrences",
                      "order": "desc"
                    }
                  }
                ],
                "compute": {
                  "aggregation": "sum",
                  "metric": "@megalinter.occurrences"
                },
                "storage": "hot"
              }
            ],
            "formulas": [
              {
                "formula": "q1",
                "limit": {
                  "count": 15,
                  "order": "desc"
                }
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Top files",
        "type": "toplist",
        "requests": [
          {
            "queries": [
              {
                "data_source": "logs",
                "name": "q1",
                "search": {
                  "query": "source:megalinter record_type:file $git_repo_name $git_branch_name"
                },
                "indexes": [
                  "*"
                ],
                "group_by": [
                  {
                    "facet": "@megalinter.file",
                    "limit": 15,
                    "sort": {
                      "aggregation": "sum",
                      "metric": "@megalinter.occurrences",
                      "order": "desc"
                    }
                  }
                ],
                "compute": {
                  "aggregation": "sum",
                  "metric": "@megalinter.occurrences"
                },
                "storage": "hot"
              }
            ],
            "formulas": [
              {
                "formula": "q1",
                "limit": {
                  "count": 15,
                  "order": "desc"
                }
              }
            ],
            "response_format": "scalar"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "MegaLinter runs & linters",
        "type": "log_stream",
        "query": "source:megalinter (record_type:run OR record_type:linter) $git_repo_name $git_branch_name",
        "columns": [
          "core_host",
          "core_service"
        ],
        "show_date_column": true,
        "show_message_column": true,
        "message_display": "expanded-md",
        "sort": {
          "column": "time",
          "order": "desc"
        }
      }
    }
  ]
}
